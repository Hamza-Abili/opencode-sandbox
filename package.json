{
  "name": "@hamzaabili/opencode-sandbox",
  "version": "0.1.2",
  "description": "OpenCode V1 + V2 command sandbox: every shell command runs inside native bubblewrap (Linux) or Seatbelt (macOS) with a read-only system, a writable project, no ambient secrets and network denied by default. Fail-closed, zero runtime dependencies.",
  "type": "module",
  "license": "MIT",
  "author": "Hamza-Abili",
  "keywords": [
    "opencode",
    "opencode-plugin",
    "opencode-v1",
    "opencode-v2",
    "sandbox",
    "bubblewrap",
    "bwrap",
    "seatbelt",
    "sandbox-exec",
    "command-sandbox",
    "agent-sandbox",
    "linux",
    "macos",
    "security",
    "agent-safety",
    "isolation"
  ],
  "homepage": "https://github.com/Hamza-Abili/opencode-sandbox#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Hamza-Abili/opencode-sandbox.git"
  },
  "bugs": {
    "url": "https://github.com/Hamza-Abili/opencode-sandbox/issues"
  },
  "main": "./index.ts",
  "types": "./src/index.ts",
  "oc-plugin": [
    "server"
  ],
  "exports": {
    ".": "./index.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "scripts",
    "index.ts",
    "README.md",
    "CHANGELOG.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "bun test",
    "ci": "bun run lint && bun run typecheck && bun run test",
    "compat": "bun run ci && bun run smoke",
    "smoke": "bun scripts/smoke.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "@types/bun": "^1.4.4",
    "typescript": "^7.0.2"
  },
  "engines": {
    "bun": ">=1.1.0",
    "opencode": ">=1.19 <2 || >=2.0"
  }
}
